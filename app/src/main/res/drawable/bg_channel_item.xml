<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#C9A44C" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#FFF4C2" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#8A6B24" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A1D29" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#343A50" />
        </shape>
    </item>
</selector>
