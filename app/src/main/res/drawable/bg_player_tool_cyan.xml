<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="#D900D2FF"/><stroke android:width="2dp" android:color="#FFFFFFFF"/><corners android:radius="8dp"/></shape></item>
    <item android:state_selected="true"><shape android:shape="rectangle"><solid android:color="#5900D2FF"/><stroke android:width="1.5dp" android:color="#FF00D2FF"/><corners android:radius="8dp"/></shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="#B300D2FF"/><corners android:radius="8dp"/></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#3300D2FF"/><stroke android:width="1dp" android:color="#8000D2FF"/><corners android:radius="8dp"/></shape></item>
</selector>
