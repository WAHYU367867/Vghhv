<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="#4D00D2FF"/><stroke android:width="2dp" android:color="#FF00D2FF"/><corners android:radius="8dp"/></shape></item>
    <item android:state_selected="true"><shape android:shape="rectangle"><solid android:color="#4000D2FF"/><stroke android:width="1.5dp" android:color="#FF00D2FF"/><corners android:radius="8dp"/></shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="#4DFFFFFF"/><corners android:radius="8dp"/></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#CC131722"/><stroke android:width="1dp" android:color="#CC253048"/><corners android:radius="8dp"/></shape></item>
</selector>
