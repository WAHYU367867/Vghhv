<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#2E00D2FF" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1E273B" />
                    <corners android:radius="12dp" />
                    <stroke android:width="2dp" android:color="#00D2FF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#181E2C" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#28354E" />
        </shape>
    </item>
</selector>
