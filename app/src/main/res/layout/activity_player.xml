<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:use_controller="true"
        app:controller_layout_id="@layout/player_controls_custom"
        app:show_timeout="0"
        app:hide_on_touch="false"
        app:show_buffering="never" />

    <!-- Centered Neon Cyan Buffering Spinner matching Web -->
    <ProgressBar
        android:id="@+id/playerBuffering"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="#00D2FF"
        android:visibility="gone" />

    <!-- Transient status banner matching Web cyan glass toast -->
    <TextView
        android:id="@+id/playerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="96dp"
        android:layout_marginEnd="96dp"
        android:layout_marginTop="76dp"
        android:background="@drawable/bg_player_title"
        android:textColor="#00D2FF"
        android:textStyle="bold"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textSize="13sp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone" />

</FrameLayout>
